# Copy to .env and fill in. No secrets here: Snowflake uses a key-pair file, AWS uses ~/.aws/credentials.
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake/rsa_key.p8
SNOWFLAKE_USER=MIG_DBT_SVC
SNOWFLAKE_ROLE=MIG_DEVELOPER
SNOWFLAKE_WAREHOUSE=MIG_WH
SNOWFLAKE_DATABASE=HC_MIGRATION_DB

AWS_REGION=ap-southeast-2
S3_BUCKET=<your-landing-bucket>

# the dbt project (and its own venv) from the migration project
MIGRATION_PROJECT=~/path/to/snowflake-healthcare-data-migration

# how long to wait for Snowpipe before giving up on a batch (seconds)
SNOWPIPE_TIMEOUT=600

# auto = agent decides and acts on its own; human = agent asks before every action
APPROVAL_MODE=auto

# email alerts (AWS SNS, free tier: 1,000 emails/month)
SNS_TOPIC_ARN=arn:aws:sns:<region>:<account-id>:hc-pipeline-alerts
